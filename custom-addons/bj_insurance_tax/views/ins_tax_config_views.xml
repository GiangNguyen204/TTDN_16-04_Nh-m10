<odoo>
  <data>
    <record id="action_bj_ins_tax_config" model="ir.actions.act_window">
      <field name="name">Insurance & Tax Config</field>
      <field name="res_model">bj.ins.tax.config</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="bj_ins_tax_menu_root"
              name="BJ Insurance & Tax"
              parent="bj_payroll_core.bj_payroll_menu_configuration"
              sequence="30"
              action="action_bj_ins_tax_config"/>

    <record id="view_bj_ins_tax_config_tree" model="ir.ui.view">
      <field name="name">bj.ins.tax.config.tree</field>
      <field name="model">bj.ins.tax.config</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="bhxh_rate_employee"/>
          <field name="bhyt_rate_employee"/>
          <field name="bhtn_rate_employee"/>
        </tree>
      </field>
    </record>

    <record id="view_bj_ins_tax_config_form" model="ir.ui.view">
      <field name="name">bj.ins.tax.config.form</field>
      <field name="model">bj.ins.tax.config</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
            </group>
            <group string="Insurance (Employee)">
              <field name="bhxh_rate_employee"/>
              <field name="bhyt_rate_employee"/>
              <field name="bhtn_rate_employee"/>
            </group>
            <group string="Tax Deductions">
              <field name="personal_deduction"/>
              <field name="dependent_deduction"/>
            </group>
            <group string="Tax Brackets">
              <field name="bracket_ids">
                <tree editable="bottom">
                  <field name="from_amount"/>
                  <field name="to_amount"/>
                  <field name="rate"/>
                  <field name="quick_deduction"/>
                </tree>
              </field>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
  </data>
</odoo>
