<odoo>
  <record id="view_res_config_settings_bj_camera" model="ir.ui.view">
    <field name="name">res.config.settings.view.form.bj.camera</field>
    <field name="model">res.config.settings</field>
    <field name="inherit_id" ref="base.res_config_settings_view_form"/>
    <field name="arch" type="xml">

      <!-- Chèn thẳng vào form (ổn định hơn sheet/settings) -->
      <xpath expr="//form" position="inside">
        <div class="app_settings_block" data-string="BJ Camera Attendance">
          <h2>BJ Camera Attendance</h2>
          <div class="row mt16 o_settings_container">
            <div class="col-12 col-lg-6 o_setting_box">
              <div class="o_setting_left_pane"/>
              <div class="o_setting_right_pane">
                <field name="camera_api_token" placeholder="dán token vào đây"/>
                <div class="text-muted">Token dùng để app camera gọi API chấm công.</div>
              </div>
            </div>
          </div>
        </div>
      </xpath>

    </field>
  </record>
</odoo>
