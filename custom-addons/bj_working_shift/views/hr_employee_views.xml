<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_form_inherit_bj_shift" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.bj.shift</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Chèn vào group đầu tiên của form (ổn cho demo) -->
            <xpath expr="//sheet//group" position="inside">
                <field name="shift_id"/>
            </xpath>
        </field>
    </record>
</odoo>
