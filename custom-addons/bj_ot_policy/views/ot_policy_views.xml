<odoo>
  <data>
    <record id="action_bj_ot_policy" model="ir.actions.act_window">
      <field name="name">OT Policy</field>
      <field name="res_model">bj.ot.policy</field>
      <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="bj_ot_policy_menu"
              name="OT Policy"
              parent="bj_payroll_core.bj_payroll_menu_configuration"
              action="action_bj_ot_policy"
              sequence="40"/>

    <record id="view_bj_ot_policy_tree" model="ir.ui.view">
      <field name="name">bj.ot.policy.tree</field>
      <field name="model">bj.ot.policy</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="weekday_rate"/>
          <field name="weekend_rate"/>
          <field name="holiday_rate"/>
          <field name="night_shift_allowance"/>
          <field name="active"/>
        </tree>
      </field>
    </record>

    <record id="view_bj_ot_policy_form" model="ir.ui.view">
      <field name="name">bj.ot.policy.form</field>
      <field name="model">bj.ot.policy</field>
      <field name="arch" type="xml">
        <form>
          <sheet>
            <group>
              <field name="name"/>
              <field name="active"/>
            </group>
            <group string="OT Rates">
              <field name="weekday_rate"/>
              <field name="weekend_rate"/>
              <field name="holiday_rate"/>
              <field name="min_ot_minutes"/>
            </group>
            <group string="Night Shift">
              <field name="night_shift_allowance"/>
            </group>
            <group string="Holidays">
              <field name="holiday_dates"/>
            </group>
          </sheet>
          <chatter/>
        </form>
      </field>
    </record>
  </data>
</odoo>
